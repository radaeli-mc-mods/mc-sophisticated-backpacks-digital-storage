    },
    "collection": {
      "layout": "features",
      "entries": [
        {
          "id": "deposit",
          "title": "Remote Deposit",
          "description": "Send matching backpack items to your linked storage network.",
          "bullets": [
            "Deposit with a button in the upgrade tab.",
            "Filter which items leave your backpack."
          ],
          "image": "../assets/upgrades/remote_deposit_upgrade.png",
          "alt": "Remote Deposit upgrade",
          "pixelated": true
        },
        {
          "id": "restock",
          "title": "Remote Restock",
          "description": "Bring supplies from your linked network into your backpack.",
          "bullets": [
            "Restock with a button in the upgrade tab.",
            "Choose which supplies to retrieve."
          ],
          "image": "../assets/upgrades/remote_restock_upgrade.png",
          "alt": "Remote Restock upgrade",
          "pixelated": true
        },
        {
          "id": "pickup",
          "title": "Remote Pickup",
          "description": "Send matching items to storage as you pick them up.",
          "bullets": [
            "Choose network or backpack priority.",
            "Keep unwanted items out with filters."
          ],
          "image": "../assets/upgrades/remote_pickup_upgrade.png",
          "alt": "Remote Pickup upgrade",
          "pixelated": true
        },
        {
          "id": "magnet",
          "title": "Remote Magnet",
          "description": "Gather nearby drops and send them to your preferred destination.",
