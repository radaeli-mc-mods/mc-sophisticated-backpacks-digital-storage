          "bullets": [
            "Choose what to keep on hand.",
            "Set your preferred supply source."
          ],
          "image": "../assets/upgrades/remote_refill_upgrade.png",
          "alt": "Remote Refill upgrade",
          "pixelated": true
        },
        {
          "id": "feeding",
          "title": "Remote Feeding",
          "description": "Stay fed with food from your backpack or linked network.",
          "bullets": [
            "Filter which foods can be used.",
            "Configure hunger and injury conditions."
          ],
          "image": "../assets/upgrades/remote_feeding_upgrade.png",
          "alt": "Remote Feeding upgrade",
          "pixelated": true
        },
        {
          "id": "alchemy",
          "title": "Remote Alchemy",
          "description": "Use configured consumables automatically when you need them.",
          "bullets": [
            "Choose consumables and trigger conditions.",
            "Set network or backpack priority."
          ],
          "image": "../assets/upgrades/remote_alchemy_upgrade.png",
          "alt": "Remote Alchemy upgrade",
          "pixelated": true
        }
      ]
    },
    "utilities": {
      "layout": "features",
      "entries": [
        {
          "id": "pump",
          "title": "Remote Pump",
          "description": "Move fluids between your linked network, backpack tank and the world.",
          "bullets": [
            "Filter fluids and configure transfer settings.",
            "Tom’s Storage supports items only."
          ],
          "image": "../assets/upgrades/remote_pump_upgrade.png",
          "alt": "Remote Pump upgrade",
          "pixelated": true
        },
        {
          "id": "crafting",
          "title": "Remote Crafting",
          "description": "Fill your crafting grid with ingredients from your backpack and network.",
          "bullets": [
            "Fetch missing ingredients for a chosen recipe.",
            "Use backpack controls or JEI recipe transfer."
          ],
          "image": "../assets/upgrades/remote_crafting_upgrade.png",
          "alt": "Remote Crafting upgrade",
          "pixelated": true
        }
      ]
    },
