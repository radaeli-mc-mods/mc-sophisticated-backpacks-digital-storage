            "Collect nearby matching item drops.",
            "Choose network or backpack priority."
          ],
          "image": "../assets/upgrades/remote_magnet_upgrade.png",
          "alt": "Remote Magnet upgrade",
          "pixelated": true
        }
      ]
    },
